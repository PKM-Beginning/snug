# ── Snug frontend (Next.js) ─────────────────────────────────────────────
# Copy to .env.local. Restart `npm run dev` (or rebuild) after changing.

# false → use the built-in mock catalogue (no backend needed)
# true  → load products from the FastAPI backend (backend/ must be running)
NEXT_PUBLIC_USE_LIVE_API=false

# Server-side only (not exposed to the browser). Where FastAPI is listening.
API_BASE_URL=http://localhost:8000

# How long Next.js may cache API responses, in seconds. Keep 0 unless you
# accept that cached prices are shown during a backend outage.
API_REVALIDATE_SECONDS=0

# Comma-separated https hosts allowed for remote product images
# (only those your affiliate programmes permit). Empty = local images only.
IMAGE_REMOTE_HOSTS=

# Public site URL, used for SEO/Open Graph metadata.
# On Vercel this can be left unset: the production domain is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines are blocked (robots.txt + noindex) unless this is "true".
# Keep it off while the site shows demonstration data.
ALLOW_INDEXING=false

# NEVER put marketplace/affiliate credentials here — they belong in backend/.env.
