# ── Snug backend (FastAPI) ──────────────────────────────────────────────
# Copy to backend/.env. Never commit the real .env file.

# development | test | production
ENVIRONMENT=development

# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://snug:change-me@localhost:5432/snug

# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Rate limits, requests per minute per client IP
RATE_LIMIT_PER_MINUTE=120
ADMIN_RATE_LIMIT_PER_MINUTE=10
# Set true ONLY when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Admin/sync endpoints (/api/admin/*) are disabled while this is empty.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Comma-separated rating sources trusted for the min_rating filter.
# Leave empty in production until real, reliable rating data exists.
# "demo" lets you try the filter with seed data during development only.
RELIABLE_RATING_SOURCES=

# ── Marketplace credentials (server-side only; not connected in Phase 2) ──
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
MYNTRA_AFFILIATE_ID=
MYNTRA_AFFILIATE_TOKEN=
